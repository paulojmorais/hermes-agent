{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ReconciliationInputSchema",
  "description": "Schema para entrada de dados de reconciliação financeira multi-app.",
  "type": "object",
  "properties": {
    "source_a_name": {
      "type": "string",
      "description": "Nome da fonte de origem A (ex: CRM, Moloni, Faturas Emitidas)"
    },
    "source_b_name": {
      "type": "string",
      "description": "Nome da fonte de origem B (ex: Extrato Millennium BCP, Stripe)"
    },
    "records_a": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "amount": { "type": "number" },
          "date": { "type": "string" }
        },
        "required": ["id", "amount"]
      }
    },
    "records_b": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "amount": { "type": "number" },
          "date": { "type": "string" }
        },
        "required": ["id", "amount"]
      }
    }
  },
  "required": ["records_a", "records_b"]
}
